# SEC EDGAR Config
SEC_USER_AGENT=ResearchProject analyst@example.com

# PostgreSQL / pgvector
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=kgrag
POSTGRES_USER=kgrag
POSTGRES_PASSWORD=your_postgres_password_here

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# OpenRouter API (Primary Provider for System One, Embeddings, and Generative LLM)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_RUNTIME=openrouter
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_DIMENSION=2048
SYSTEM_ONE_MODEL=inception/mercury-decide:free

# Ollama / Local Fallback (Optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_LLM_MODEL=qwen2.5:3b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text:latest
